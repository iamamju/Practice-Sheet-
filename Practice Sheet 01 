"""
Q1

Ek line input lo jisme 2 ya zyada words hon.

Us line me:

- total number of words print karo
- longest word print karo
- shortest word print karo

Conditions:

- "split()" use karna hai
- "max()" aur "min()" direct use nahi karne
- loop aur "len()" use karna hai

Example Input

I am learning Python fast

Expected Output

5
learning
I

---""" 

#Solution👇

text_line = input("Enter a text line: ").split()

l = len(text_line)

longest = text_line[0]
shortest = text_line[0]

print("Total words =", l)

for i in range(l):
    if len(text_line[i]) > len(longest):
        longest = text_line[i]

    if len(text_line[i]) < len(shortest):
        shortest = text_line[i]

print("Longest =", longest)
print("Shortest =", shortest)


#Q2

Ek string input lo.

Us string ke:

- vowels count karo
- consonants count karo
- spaces count karo

Phir print karo:

- "Vowels = X"
- "Consonants = Y"
- "Spaces = Z"

Conditions:

- lowercase/uppercase dono handle karne hain
- spaces aur symbols consonant me count nahi hone chahiye

Example Input

Data Science is fun

Expected Output

Vowels = 6
Consonants = 9
Spaces = 3

---"""

#Solution👇

string_line = input("enter a multiple string line :")


l = len(string_line)

vowels = 0
consonants = 0
spaces = 0
symbols = 0
numbers = 0


vowel_list = "aeiouAEIOU"
consonants_list = "bcdfghjklmnpqrstvwxyzBCDFGHJKLMNPQRSTVWXYZ"

number_list = "0123456789"
_spaces_ = " "


for ch in string_line:
    if ch in consonants_list:
        consonants += 1
    elif ch in vowel_list:
        vowels += 1
    elif ch in _spaces_:
        spaces += 1
    elif ch in number_list:
        numbers += 1
    else:
        symbols += 1

print("vowels =" , vowels)
print("consonants =" , consonants)
print("spaces =" , spaces)
print("numbers" , numbers)
print("symbols =", symbols)
                                                                    

#Q3

📝 Problem

Take a string as input and:

• Print only the alphabetic characters
• Skip digits and symbols
• Print the first alphabetic character
• Print the last alphabetic character
• Count the total alphabetic characters

Condition:
Use loops and comparisons — do not use "isalpha()".

Example Input:

"A1b@C9d!"

Expected Output:

"AbCd"
"A"
"d"
"4"


#Solution👇

string = input("enter a string:")

letter_lst = []
count_letter = 0

letters = "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ"

for i in string:
    if i in letters:
        print(i, end="")
        letter_lst.append(i)
        count_letter += 1

print()

print(letter_lst[0])
print(letter_lst[-1])
print(count_letter)

