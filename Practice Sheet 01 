    marks_lst = [ ]
    total = 0 
    
    
    for i in range(subjects):
        sub = input(f"enter subject name {i+1}:")
        sub_lst.append(sub)
    for j in sub_lst:
        marks = int(input(f"enter {j} marks "))
        marks_lst.append(marks)
        
    for mark in marks_lst:
        total += mark
        
    highest = marks_lst[0]
    lowest = marks_lst[0]
    
    for mark in marks_lst:
        if mark > highest:
            highest = mark
        elif mark < lowest:
            lowest = mark
    
    average = total / len(marks_lst)
    
    print(name)
    print(total)
    print(average)
    print(highest)
    print(lowest)
    if lowest >= 33:
        print("Pass")
    else:
        print("Fail")   
    

